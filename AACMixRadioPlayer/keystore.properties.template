# Keystore configuration for release builds
# Copy this file to keystore.properties and fill in your values
# DO NOT commit keystore.properties to version control!

# Path to your keystore file (relative to project root)
# Example: keystore/release.jks (if keystore is in project/keystore/ folder)
# Example: app/release.jks (if keystore is in project/app/ folder)
storeFile=keystore/release.jks

# Keystore password
storePassword=your_keystore_password

# Key alias
keyAlias=your_key_alias

# Key password
keyPassword=your_key_password
